{
  "name": "nomi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @nomi/api\" \"npm run dev --workspace @nomi/web\"",
    "build": "npm run build --workspace @nomi/api && npm run build --workspace @nomi/web",
    "lint": "npm run lint --workspace @nomi/api && npm run lint --workspace @nomi/web",
    "test": "npm run test --workspace @nomi/api && playwright test",
    "test:api": "npm run test --workspace @nomi/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.0.1",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
